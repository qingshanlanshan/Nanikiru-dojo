// Cloudflare Workers config: a static-only site (no Worker script) served from dist/.
// Workers Builds runs `npm run build` then `npx wrangler deploy` from this folder.
{
  "name": "heqie-dojo",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
  },
  // Cloudflare creates the DNS record and certificate for the custom domain.
  "routes": [{ "pattern": "heqie.qshlab.com", "custom_domain": true }],
  // Keep the original *.workers.dev address working for links already shared.
  "workers_dev": true,
}
